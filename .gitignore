# Pipeline output directories. `results` is the conventional --outdir, and run
# comparisons tend to land beside it as results_<something>/.
results/
results_*/

# GSD planning docs and session handoff state (local-only)
.planning/
.planning/STATE.md
.continue-here.md

# Internal development handoff and validation notes (local-only). These quote
# laboratory sample and sequencing run identifiers from routine diagnostic runs,
# so they must not be published with the pipeline. Findings that outlive a
# handoff belong in CHANGELOG.md, docs/, or a code comment instead.
/hcvtyper_*
/*_hcvtyper_*
