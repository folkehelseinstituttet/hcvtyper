/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

//
// General configuration options
//

process {
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'SAMPLESHEET_CHECK' {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // BOWTIE2_BUILD carries the upstream 'process_high' label (12 CPU / 72 GB / 16 h),
    // which is far oversized for indexing HCV references (~9.5 kb) and is invoked once
    // per sample by JOINT_MAPPING. A local patch used to set 'process_low' on the module
    // itself, but was lost when the module was updated; withName outranks withLabel, so
    // the resource intent is restored here instead of by re-patching.
    withName: BOWTIE2_BUILD {
        cpus   = { 2     * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
        // Don't publish any files from this process. The module emits its index as a
        // directory literally named `bowtie2` (`path('bowtie2'), emit: index`) — NOT
        // sample-prefixed. JOINT_MAPPING builds one index per sample, so under the
        // default catch-all publishDir every sample wrote that same directory name
        // into ${outdir}/bowtie2/ and they clobbered each other: only ONE sample's
        // six .bt2 files survived, and which sample won varied with task completion
        // order between runs. Nothing consumes the index from outdir (BOWTIE2_ALIGN
        // receives it through the channel), it is regenerable from the published
        // candidate FASTAs, and it was never a documented output — it was published
        // only because it fell through the default publishDir, never by intent.
        // Matches the BOWTIE2_ALIGN treatment in conf/modules_hcv.config.
        publishDir = [
            enabled: false
        ]
    }

    withName: FASTQC_RAW {
        ext.args = '--quiet'
        ext.prefix = { "${meta.id}.raw" } // Avoid name collision with FASTQC_TRIM
    }

    withName: FASTQC_TRIM {
        ext.args = '--quiet'
        // Underscore, not dot: MultiQC's default fn_clean_exts truncates any sample
        // name at the first occurrence of the literal substring ".trim" (meant for
        // things like "sample.trim.bam"), wherever it appears — not just as a
        // trailing extension. "${meta.id}.trimmed_1"/"_2" both contain ".trim" right
        // after meta.id, so MultiQC truncated both mates down to bare "${meta.id}",
        // and the second one parsed silently overwrote the first in the report.
        // "_trimmed" avoids that literal substring and keeps the mates distinct.
        ext.prefix = { "${meta.id}_trimmed" } // Avoid name collision with FASTQC_RAW
    }

    withName: 'FASTP' {
        publishDir = [
            path: { "${params.outdir}/fastp" },
            mode: params.publish_dir_mode,
            pattern: '*.{log,html,json}'
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = params.multiqc_title ? "--title \"$params.multiqc_title\"" : ''
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CUTADAPT' {
        ext.args = '-q 30 -m 50'
        publishDir = [
            path: { "${params.outdir}/cutadapt" },
            mode: params.publish_dir_mode,
            pattern: '*.log'
        ]
    }

    withName: PRINSEQPLUSPLUS {
        ext.args = "-lc_entropy=0.5" // Higher is more stringent. I.e. low values retain more low complexity reads. 0.5 is the default.
        publishDir = [
            path: { "${params.outdir}/prinseqplusplus" },
            mode: params.publish_dir_mode,
            pattern: '*.log'
        ]
    }

    withName: 'UNTAR_KRAKEN_ALL' {
        publishDir = [
            enabled: false // Don't publish any files from this process
        ]
    }

    withName: 'UNTAR_KRAKEN_FOCUSED' {
        publishDir = [
            enabled: false // Don't publish any files from this process
        ]
    }

}

includeConfig 'modules_hcv.config'
