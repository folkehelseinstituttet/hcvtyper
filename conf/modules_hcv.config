/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

params {
    save_output_fastqs = true
    save_reads_assignment = true
    minRead = 499
    minCov = 29
    denovo_min_blast_identity = 90
    denovo_match_level = 'genotype'
    denovo_confirm_minor = true
    n_candidates = 2
}

process {

    withName: 'FOLKEHELSEINSTITUTTET_HCVTYPER:HCVTYPER:HCV_GLUE_PARSER.*' {
        publishDir = [
            path: { "${params.outdir}/hcvglue" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }

    withName: 'FOLKEHELSEINSTITUTTET_HCVTYPER:HCVTYPER:HCVGLUE.*' {
        containerOptions = '-v /var/run/docker.sock:/var/run/docker.sock'
        time = 12.h
        publishDir = [
            path: { "${params.outdir}/hcvglue" },
            mode: params.publish_dir_mode,
            pattern: '*.{json,html}'
        ]
    }

    withName: 'FOLKEHELSEINSTITUTTET_HCVTYPER:HCVTYPER:KRAKEN2_FOCUSED' {
        ext.prefix = { "${meta.id}.focused" }
        publishDir = [
            path: { "${params.outdir}/kraken2" },
            mode: params.publish_dir_mode,
            pattern: '*{report.txt,.classified*.fastq.gz}' // Publish both kraken report and classified files
        ]
    }

    withName: 'FOLKEHELSEINSTITUTTET_HCVTYPER:HCVTYPER:KRAKEN2_KRAKEN2' {
        ext.prefix = { "${meta.id}.entireDB" }
        publishDir = [
            path: { "${params.outdir}/kraken2" },
            mode: params.publish_dir_mode,
            pattern: '*{report.txt}' // Publish only kraken2 report
        ]
    }

    withName: 'FOLKEHELSEINSTITUTTET_HCVTYPER:HCVTYPER:BOWTIE2_ALIGN' {
        ext.args = "--very-sensitive-local"
        publishDir = [
            enabled: false // Don't publish any files from this process
        ]
    }

    withName: 'FOLKEHELSEINSTITUTTET_HCVTYPER:HCVTYPER:PICARD_COLLECTINSERTSIZEMETRICS' {
        label      = "error_ignore"
    }

    withName: 'FOLKEHELSEINSTITUTTET_HCVTYPER:HCVTYPER:BLAST_MAKEBLASTDB' {
        ext.args = "-dbtype nucl"
        publishDir = [
            enabled: false // Don't publish any files from this process
        ]
    }

    withName: 'FOLKEHELSEINSTITUTTET_HCVTYPER:HCVTYPER:BLAST_BLASTN' {
        ext.args = "-outfmt 6"
    }

    withName: 'FOLKEHELSEINSTITUTTET_HCVTYPER:HCVTYPER:BLASTPARSE' {
        publishDir = [
            [
                enabled: true,
                path: { "${params.outdir}/blastparse" },
                mode: params.publish_dir_mode,
                pattern: '*.{csv}'
            ],
            [
                enabled: true,
                path: { "${params.outdir}/QC/denovo" },
                mode: params.publish_dir_mode,
                pattern: '*.{png}'
            ]
        ]
    }

    withName: 'FOLKEHELSEINSTITUTTET_HCVTYPER:HCVTYPER:RESCUE_EVALUATION' {
        // De novo subtype-rescue evaluator (Phase 10). The five thresholds are passed
        // POSITIONALLY in the exact order rescue_evaluation.R reads them after its five
        // path args (prefix candidates blastparse support references):
        //   rescue_min_length rescue_min_pident rescue_min_aln_length rescue_min_kmer_cov rescue_1a1b_length n_candidates
        // n_candidates (10th, optional) caps the genotype-diverse final candidate set
        // (one reference per genotype after de-novo nomination + collapse, 1a/1b exempt).
        ext.args   = { "${params.rescue_min_length} ${params.rescue_min_pident} ${params.rescue_min_aln_length} ${params.rescue_min_kmer_cov} ${params.rescue_1a1b_length} ${params.n_candidates}" }
        publishDir = [
            enabled: true,
            path: { "${params.outdir}/blastparse" },
            mode: params.publish_dir_mode,
            pattern: '*.{csv}'
        ]
    }

    withName: 'FOLKEHELSEINSTITUTTET_HCVTYPER:HCVTYPER:SPADES' {
        label    = "error_ignore" // Ignore errors from this process.
        ext.args = "--rnaviral --phred-offset 33"
    }

    withName: 'FOLKEHELSEINSTITUTTET_HCVTYPER:HCVTYPER:SAMTOOLS_SORMADUP' {
        label      = "error_ignore" // Ignore errors from this process.
        ext.prefix = { "${meta.id}.firstmapping.nodup" }
        ext.args5 = "-r"
    }

    withName: 'FOLKEHELSEINSTITUTTET_HCVTYPER:HCVTYPER:GET_MAPPING_STATS_WITHDUP:SAMTOOLS_INDEX' {
        ext.prefix = { "${meta.id}.firstmapping.withdup" }
        publishDir = [
            enabled: false,
            path: { "${params.outdir}/samtools" },
            mode: params.publish_dir_mode,
            pattern: '*.bai'
        ]
    }

    withName: 'FOLKEHELSEINSTITUTTET_HCVTYPER:HCVTYPER:GET_MAPPING_STATS_MARKDUP:SAMTOOLS_INDEX' {
        ext.prefix = { "${meta.id}.firstmapping.nodup" }
        publishDir = [
            enabled: true,
            path: { "${params.outdir}/samtools" },
            mode: params.publish_dir_mode,
            pattern: '*.bai'
        ]
    }

    withName: 'FOLKEHELSEINSTITUTTET_HCVTYPER:HCVTYPER:GET_MAPPING_STATS_WITHDUP:SAMTOOLS_IDXSTATS' {
        ext.prefix = { "${meta.id}.firstmapping.withdup" }
        publishDir = [
            enabled: false, // Don't publish any files from this process
            path: { "${params.outdir}/samtools" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'FOLKEHELSEINSTITUTTET_HCVTYPER:HCVTYPER:GET_MAPPING_STATS_WITHDUP:CSVTK_SORT' {
        ext.args = '-H -k 3:nr' // No header. And sort the 3rd column (mapped reads) numerically in reverse order.
        ext.prefix = { "${meta.id}.firstmapping.withdup.sorted" }
        publishDir = [
            enabled: true,
            path: { "${params.outdir}/samtools" },
            mode: params.publish_dir_mode,
        ]
    }


    withName: 'FOLKEHELSEINSTITUTTET_HCVTYPER:HCVTYPER:GET_MAPPING_STATS_WITHDUP:SAMTOOLS_STATS' {
        ext.prefix = { "${meta.id}.firstmapping.withdup" }
        publishDir = [
            enabled: true,
            path: { "${params.outdir}/samtools" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'FOLKEHELSEINSTITUTTET_HCVTYPER:HCVTYPER:GET_MAPPING_STATS_MARKDUP:CSVTK_SORT' {
        ext.args = '-H -k 3:nr' // No header. And sort the 3rd column (mapped reads) numerically in reverse order.
        publishDir = [
            enabled: false // Don't publish any files from this process
        ]
    }

    withName: 'FOLKEHELSEINSTITUTTET_HCVTYPER:HCVTYPER:GET_MAPPING_STATS_MARKDUP:SAMTOOLS_IDXSTATS' {
        ext.prefix = { "${meta.id}.firstmapping.nodup" }
        publishDir = [
            path: { "${params.outdir}/samtools" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'FOLKEHELSEINSTITUTTET_HCVTYPER:HCVTYPER:GET_MAPPING_STATS.*:SAMTOOLS_DEPTH.*' {
        ext.args   = '-aa -d 1000000'
        publishDir = [
            enabled: false // Don't publish any files from this process
        ]
    }

    withName: 'FOLKEHELSEINSTITUTTET_HCVTYPER:HCVTYPER:GET_MAPPING_STATS_MARKDUP:SAMTOOLS_STATS' {
        ext.prefix = { "${meta.id}.firstmapping.nodup" }
        publishDir = [
            path: { "${params.outdir}/samtools" },
            mode: params.publish_dir_mode,
        ]
    }

    // ── Competitive joint mapping (JOINT_MAPPING) — Phase 11, replaces TARGETED_MAPPING ──
    //
    // JOINT_MAPPING maps all candidate references for a sample ONCE against a combined index,
    // then splits the combined dedup BAM by reference (SAMTOOLS_VIEW positional region) into
    // per-candidate BAMs. The ext.prefix closures below keep output filenames BYTE-IDENTICAL
    // to the legacy cand-slot so bin/summarize.R parses unchanged. Read counts now come from
    // SAMTOOLS_IDXSTATS on the combined BAM pre/post dedup (D-07/D-09/D-15); SAMTOOLS_STATS
    // is gone. .toInteger() is safe ONLY inside these config closures — they evaluate solely
    // for passing candidates that survive the subworkflow's confirmation_status filter, never
    // on a possibly-NA channel field (Pitfall 4).

    // Keep --very-sensitive-local (do NOT switch to end-to-end — that changes consensus and
    // breaks COMPAT golden reproduction, Pitfall 5).
    withName: 'FOLKEHELSEINSTITUTTET_HCVTYPER:HCVTYPER:JOINT_MAPPING:BOWTIE2_ALIGN' {
        ext.args = "--very-sensitive-local"
        publishDir = [
            enabled: false // Don't publish any files from this process
        ]
    }

    // CAT_CANDIDATES: per-sample combined FASTA — internal artefact, not published.
    withName: 'FOLKEHELSEINSTITUTTET_HCVTYPER:HCVTYPER:JOINT_MAPPING:CAT_CANDIDATES' {
        publishDir = [
            enabled: false
        ]
    }

    // SORMADUP runs on the COMBINED multi-reference BAM (pre-split), so it carries only
    // meta.id (NOT a candidate slot). A distinct prefix avoids the markdup input/output name
    // collision (both would otherwise default to ${meta.id}.bam). -r removes duplicates.
    withName: 'FOLKEHELSEINSTITUTTET_HCVTYPER:HCVTYPER:JOINT_MAPPING:SAMTOOLS_SORMADUP' {
        label      = "error_ignore"
        ext.prefix = { "${meta.id}.combined.nodup" }
        ext.args5  = "-r"
    }

    // INDEX_COMBINED / INDEX_DEDUP: .bai for idxstats + the region split — never published
    // (mirror TARGETED_MAPPING:INDEX_WITHDUP / the GET_MAPPING_STATS index handling).
    withName: 'FOLKEHELSEINSTITUTTET_HCVTYPER:HCVTYPER:JOINT_MAPPING:INDEX_COMBINED' {
        publishDir = [
            enabled: false
        ]
    }

    withName: 'FOLKEHELSEINSTITUTTET_HCVTYPER:HCVTYPER:JOINT_MAPPING:INDEX_DEDUP' {
        publishDir = [
            enabled: false,
            pattern: '*.bai'
        ]
    }

    // IDXSTATS on the COMBINED BAM — ONE file per sample, every candidate reference as a row.
    // The idxstats module appends `.idxstats`, so prefix ${meta.id}.withdup yields
    // ${id}.withdup.idxstats. summarize.R reads path_4 = stats_withdup/ (Open Q2: dir name
    // KEPT; only file content + suffix change to idxstats; Plan 03 migrates the parser).
    withName: 'FOLKEHELSEINSTITUTTET_HCVTYPER:HCVTYPER:JOINT_MAPPING:IDXSTATS_WITHDUP' {
        ext.prefix = { "${meta.id}.withdup" }
        publishDir = [
            path: { "${params.outdir}/samtools" },
            mode: params.publish_dir_mode,
        ]
    }

    // IDXSTATS post-dedup -> ${id}.nodup.idxstats. summarize.R reads path_5 = stats_markdup/.
    withName: 'FOLKEHELSEINSTITUTTET_HCVTYPER:HCVTYPER:JOINT_MAPPING:IDXSTATS_NODUP' {
        ext.prefix = { "${meta.id}.nodup" }
        publishDir = [
            path: { "${params.outdir}/samtools" },
            mode: params.publish_dir_mode,
        ]
    }

    // SAMTOOLS_VIEW: split the combined dedup BAM by POSITIONAL region (candidate_ref via
    // ext.args2 — lands after ${input} in the nf-core command, NOT the -r read-group flag,
    // Pitfall 1). ext.args '-b' emits BAM. ext.prefix keeps the byte-identical cand-slot.
    // SAMTOOLS_VIEW input carries the full per-candidate meta (meta namespace, NOT meta1).
    withName: 'FOLKEHELSEINSTITUTTET_HCVTYPER:HCVTYPER:JOINT_MAPPING:SAMTOOLS_VIEW' {
        ext.args   = '-b'
        ext.args2  = { "${meta.candidate_ref}" }
        ext.prefix = { "${meta.id}.${meta.candidate_ref}.cand${meta.candidate_rank.toInteger()}.nodup" }
        publishDir = [
            enabled: false
        ]
    }

    // REHEADER_CANDIDATE: rebuild a single-reference BAM (drops the other @SQ lines that
    // would corrupt per-candidate depth breadth / cv_evenness — Pitfall 2). Distinct suffix.
    withName: 'FOLKEHELSEINSTITUTTET_HCVTYPER:HCVTYPER:JOINT_MAPPING:REHEADER_CANDIDATE' {
        ext.prefix = { "${meta.id}.${meta.candidate_ref}.cand${meta.candidate_rank.toInteger()}.nodup.single" }
        publishDir = [
            enabled: false
        ]
    }

    // SAMTOOLS_DEPTH runs per-candidate (post-split). Its input is the joined-meta `meta1`
    // namespace (not meta). The filename must dot-split to [sample].[ref].[cand{rank}]... so
    // bin/bam_coverage.R and summarize.R's coverage loop parse reference at position [2] and
    // recover candidate_rank via the candidates-CSV join.
    withName: 'FOLKEHELSEINSTITUTTET_HCVTYPER:HCVTYPER:JOINT_MAPPING:SAMTOOLS_DEPTH' {
        ext.args   = '-aa -d 1000000'
        ext.prefix = { "${meta1.id}.${meta1.candidate_ref}.cand${meta1.candidate_rank.toInteger()}.nodup" }
    }

    // IVAR_CONSENSUS / CONSENSUS_DISTANCE keep the `${meta.id}.cand{rank}` shape (NO reference
    // field) — summarize.R's consensus-distance loop parses the slot at filename position [2]
    // (copied verbatim from the TARGETED_MAPPING blocks).
    withName: 'FOLKEHELSEINSTITUTTET_HCVTYPER:HCVTYPER:JOINT_MAPPING:IVAR_CONSENSUS' {
        ext.prefix = { "${meta.id}.cand${meta.candidate_rank.toInteger()}" }
        ext.args = '-t 0 -q 1 -m 10 -n N'
        ext.args2 = '--count-orphans --no-BAQ --max-depth 0 --min-BQ 0 -aa'
    }

    withName: 'FOLKEHELSEINSTITUTTET_HCVTYPER:HCVTYPER:JOINT_MAPPING:CONSENSUS_DISTANCE' {
        ext.prefix = { "${meta.id}.cand${meta.candidate_rank.toInteger()}" }
    }

    withName: 'PLOT_BAMVARIATION' {
        publishDir = [
            path: { "${params.outdir}/QC/bam_variation" },
            mode: params.publish_dir_mode,
            pattern: '*{.png,.tsv}'
        ]
    }

    withName: 'PLOTCOVERAGE' {
        publishDir = [
            path: { "${params.outdir}/QC/coverage_plots" },
            mode: params.publish_dir_mode,
            pattern: '*{.png}'
        ]
    }

    withName: 'PICARD_COLLECTINSERTSIZEMETRICS' {
        publishDir = [
            path: { "${params.outdir}/QC/insert_size" },
            mode: params.publish_dir_mode,
            pattern: '*{.pdf,.txt}'
        ]
    }

    // ── Contamination check subworkflow ────────────────────────────────────────

    withName: 'FOLKEHELSEINSTITUTTET_HCVTYPER:HCVTYPER:CONTAMINATION_CHECK:CONTIG_FILTER_RENAME' {
        ext.args   = { "${params.contamination_min_length}" }
        publishDir = [ enabled: false ]
    }

    withName: 'FOLKEHELSEINSTITUTTET_HCVTYPER:HCVTYPER:CONTAMINATION_CHECK:CAT_FILTERED_CONTIGS' {
        publishDir = [ enabled: false ]
    }

    withName: 'FOLKEHELSEINSTITUTTET_HCVTYPER:HCVTYPER:CONTAMINATION_CHECK:BLAST_MAKEBLASTDB_CONTIGS' {
        ext.args   = "-dbtype nucl"
        publishDir = [ enabled: false ]
    }

    withName: 'FOLKEHELSEINSTITUTTET_HCVTYPER:HCVTYPER:CONTAMINATION_CHECK:BLAST_BLASTN_CONTIGS' {
        // Local alignment (default blastn) handles contigs of very different lengths.
        // perc_identity threshold is set from params.contamination_min_id.
        // -dust no disables low-complexity masking (appropriate for viral sequences).
        ext.args   = { "-outfmt '6 qseqid sseqid pident length mismatch gapopen qstart qend sstart send evalue bitscore' -perc_identity ${params.contamination_min_id} -dust no" }
        ext.prefix = "all_samples_contigs"
        publishDir = [ enabled: false ]
    }

    withName: 'FOLKEHELSEINSTITUTTET_HCVTYPER:HCVTYPER:CONTAMINATION_CHECK:CONTAMINATION_REPORT' {
        ext.prefix = "contamination"
        ext.args   = { "${params.contamination_hop_rate} ${params.contamination_min_dir_ratio} ${params.contamination_genome_size} ${params.contamination_kmer_size} ${params.contamination_min_aln_cov}" }
        publishDir = [
            [
                path: { "${params.outdir}/contamination_check" },
                mode: params.publish_dir_mode,
                pattern: '*.{tsv,png,json}'
            ]
        ]
    }

    withName: 'FOLKEHELSEINSTITUTTET_HCVTYPER:HCVTYPER:SUMMARIZE' {
        ext.args   = { "${params.denovo_min_contig_length} ${params.denovo_min_kmer_cov} ${params.denovo_min_blast_identity} ${params.denovo_match_level} ${params.denovo_confirm_minor} ${params.minRead} ${params.minCov} ${params.n_candidates} ${params.score_weight_evenness} ${params.score_weight_reads} ${params.score_weight_kmercov} ${params.score_evenness_k}" }
        publishDir = [
            [
                // Publish the summary tsv-file
                path: { "${params.outdir}/summary" },
                mode: params.publish_dir_mode,
                pattern: 'Summary.csv'
            ],
            [
                // Publish the bam variation grid plot to the QC directory
                path: { "${params.outdir}/QC/bam_variation" },
                mode: params.publish_dir_mode,
                pattern: '*{.png}'
            ],
            [
                // Publish the enriched long candidates CSV (CLASS-03: dominant / co-infection / background per candidate)
                path: { "${params.outdir}/summary" },
                mode: params.publish_dir_mode,
                pattern: 'candidates.csv'
            ]
        ]
    }
}
