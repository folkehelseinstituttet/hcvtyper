<?xml version="1.0" encoding="UTF-8"?>
<!--
  GLUE engine configuration for the hcvglue-allinone single-container image.

  Source: github.com/giffordlabcvr/gluetools/gluetools-core/docker/gluetools-config.xml
  ONLY the host in <jdbcUrl> is changed from the upstream linked-container host
  to 127.0.0.1
  so the engine connects to the task-local mysqld started by run-glue.sh
  (loopback only; never 0.0.0.0). BLAST/MAFFT/SAM properties are unchanged
  from upstream.
-->
<gluetools>
  <database>
    <username>gluetools</username>
    <password>glue12345</password>
    <jdbcUrl>jdbc:mysql://127.0.0.1:3306/GLUE_TOOLS?characterEncoding=UTF-8&amp;useSSL=false</jdbcUrl>
  </database>
  <properties>
    <!-- BLAST/MAFFT/SAM tool properties unchanged from upstream gluetools-config.xml -->
    <property>
      <name>gluetools.core.programs.blast.blastn.executable</name>
      <value>/usr/bin/blastn</value>
    </property>
    <property>
      <name>gluetools.core.programs.blast.tblastn.executable</name>
      <value>/usr/bin/tblastn</value>
    </property>
    <property>
      <name>gluetools.core.programs.blast.makeblastdb.executable</name>
      <value>/usr/bin/makeblastdb</value>
    </property>
    <property>
      <name>gluetools.core.programs.blast.temp.dir</name>
      <value>/tmp/blastfiles</value>
    </property>
    <property>
      <name>gluetools.core.programs.blast.db.dir</name>
      <value>/tmp/blastdbs</value>
    </property>
    <property>
      <name>gluetools.core.programs.mafft.executable</name>
      <value>/usr/bin/mafft</value>
    </property>
    <property>
      <name>gluetools.core.programs.mafft.temp.dir</name>
      <value>/tmp/mafftfiles</value>
    </property>
    <property>
      <name>gluetools.core.programs.samtools.executable</name>
      <value>/usr/bin/samtools</value>
    </property>
    <property>
      <name>gluetools.core.programs.samtools.temp.dir</name>
      <value>/tmp/samfiles</value>
    </property>
  </properties>
</gluetools>
