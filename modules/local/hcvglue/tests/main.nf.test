// TODO nf-core: Once you have added the required tests, please run the following command to build this file:
// nf-core modules test hcvglue
nextflow_process {

    name "Test Process HCVGLUE"
    script "../main.nf"
    process "HCVGLUE"

    tag "modules"
    tag "hcvglue"

    // Live end-to-end test: requires the published hcvglue-allinone image AND the
    // real ~59 MB ncbi_hcv_glue.sql.gz dump to produce a genotype call. The
    // placeholder tests/dump.sql.gz is empty, so this is gated to the heavier
    // integration job (Plan 03) — exclude from the fast PR run with
    // `--without-tag live_dump`. RESEARCH Open Question 3.
    test("hcv - bam") {

        tag "live_dump"

        when {
            process {
                """
                input[0] = [
                    [ id: 'Test_2.3a_D17763' ],
                    file("${moduleDir}/tests/Test_2.3a_D17763_major.major.nodup.bam", checkIfExists: true),
                    file(params.hcvglue_db, checkIfExists: true)
                ]
                input[1] = 15.0  // hcvglue_threshold
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.versions,
                    file(process.out.GLUE_json[0]).name,
                    file(process.out.GLUE_html[0]).name
                ).match() }
            )
        }

    }

    test("hcv - bam - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id: 'Test_2.3a_D17763' ],
                    file("${moduleDir}/tests/Test_2.3a_D17763_major.major.nodup.bam", checkIfExists: true),
                    file("${moduleDir}/tests/dump.sql.gz", checkIfExists: true)
                ]
                input[1] = 15.0  // hcvglue_threshold
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.versions,
                    file(process.out.GLUE_json[0]).name,
                    file(process.out.GLUE_html[0]).name
                ).match() }
            )
        }

    }

}
