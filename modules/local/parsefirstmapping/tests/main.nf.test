nextflow_process {

  name "Test Process PARSEFIRSTMAPPING"
  script "../main.nf"
  process "PARSEFIRSTMAPPING"

  tag "modules"
  tag "parsefirstmapping"

  // Real run with idxstats and depth files
  test("parsefirstmapping: idxstats + depth + references") {
    options "--profile docker"
    when {
      process {
        """
        // Input signature:
        // tuple val(meta), path(idxstats), path(depth)
        // path(references)
        // path(genotype_utils)

        input[0] = [
          [ id: 'Test_2' ],
          file("${projectDir}/modules/local/parsefirstmapping/tests/Test_2.firstmapping.withdup.idxstats", checkIfExists: true),
          file("${projectDir}/modules/local/parsefirstmapping/tests/Test_2.tsv", checkIfExists: true)
        ]
        input[1] = file("${projectDir}/modules/local/parsefirstmapping/tests/references.fa", checkIfExists: true)
        input[2] = file("${projectDir}/bin/genotype_utils.R", checkIfExists: true)
        """
      }
    }
    then {
      // The long-format candidates emit (REFSEL-01) must be present and carry the
      // Plan-01 long-format header (one row per neutrally-ranked candidate).
      def candHeader = path(process.out.candidates.get(0).get(1)).readLines()[0]
      assertAll(
        { assert process.success },
        { assert process.out.candidates.size() == 1 },
        { assert candHeader.contains('candidate_rank') },
        { assert candHeader.contains('candidate_ref') },
        { assert candHeader.contains('confirmation_status') },
        { assert snapshot([
            csv           : process.out.csv,
            candidate_fasta: process.out.candidate_fasta,
            candidates    : process.out.candidates,
            versions      : process.out.versions
          ]).match() }
      )
    }
  }

  // Fast stub run
  test("parsefirstmapping: stub") {
    options "-stub-run"
    when {
      process {
        """
        input[0] = [
          [ id: 'Test_2' ],
          file("${projectDir}/modules/local/parsefirstmapping/tests/Test_2.firstmapping.withdup.idxstats", checkIfExists: true),
          file("${projectDir}/modules/local/parsefirstmapping/tests/Test_2.tsv", checkIfExists: true)
        ]
        input[1] = file("${projectDir}/modules/local/parsefirstmapping/tests/references.fa", checkIfExists: true)
        input[2] = file("${projectDir}/bin/genotype_utils.R", checkIfExists: true)
        """
      }
    }
    then {
      // -stub-run must fan out into 2 candidate rows (cand_1/cand_2) so the
      // workflow splitCsv fan-out exercises the multi-candidate path.
      def candLines = path(process.out.candidates.get(0).get(1)).readLines()
      assertAll(
        { assert process.success },
        { assert process.out.candidates.size() == 1 },
        { assert candLines[0].contains('candidate_rank') },
        // header + 2 candidate rows
        { assert candLines.size() == 3 },
        { assert snapshot([
            csv           : process.out.csv,
            candidate_fasta: process.out.candidate_fasta,
            candidates    : process.out.candidates,
            versions      : process.out.versions
          ]).match() }
      )
    }
  }

  // GATE-03: a dominant 2k1b subtype must keep its whole name as the genotype
  // (the helper returns "2k1b", NOT "2"). The selected major FASTA is the 2k1b
  // reference.
  //
  // D-05 note: selection no longer applies validity filtering (is_valid_minor is
  // deleted; validity rules moved to Phase 8). Here no 2nd candidate is selected
  // NOT because a rule blocked it, but because this fixture maps to a SINGLE
  // distinct subtype (2k1b only) — neutral read-recruitment ranking yields exactly
  // one candidate, so candidate_fasta carries only _cand1.fa and only 1 candidates row appears.
  test("parsefirstmapping: 2k1b major keeps whole-name genotype (GATE-03)") {
    options "--profile docker"
    when {
      process {
        """
        input[0] = [
          [ id: '2k1b_test' ],
          file("${projectDir}/modules/local/parsefirstmapping/tests/2k1b.firstmapping.withdup.idxstats", checkIfExists: true),
          file("${projectDir}/modules/local/parsefirstmapping/tests/2k1b.tsv", checkIfExists: true)
        ]
        input[1] = file("${projectDir}/modules/local/parsefirstmapping/tests/references.fa", checkIfExists: true)
        input[2] = file("${projectDir}/bin/genotype_utils.R", checkIfExists: true)
        """
      }
    }
    then {
      // Single-subtype fixture => exactly one neutrally-ranked candidate (D-05).
      def candLines = path(process.out.candidates.get(0).get(1)).readLines()
      assertAll(
        { assert process.success },
        // The selected first candidate (rank 1) is the 2k1b reference (helper kept the whole name).
        { assert process.out.candidate_fasta.get(0).get(2).toString().contains("2k1b_AB031663_cand1.fa") },
        // Single distinct subtype => exactly one candidate FASTA (_cand1.fa) and no
        // 2nd-rank FASTA (D-05: not a validity-rule block — there simply is no second
        // subtype to rank).
        { assert process.out.candidate_fasta.get(0).get(2).toString().contains("_cand1.fa") },
        { assert !process.out.candidate_fasta.get(0).get(2).toString().contains("_cand2.fa") },
        { assert candLines[0].contains('candidate_rank') },
        // header + exactly 1 candidate row
        { assert candLines.size() == 2 },
        { assert snapshot([
            csv           : process.out.csv,
            candidate_fasta: process.out.candidate_fasta,
            candidates    : process.out.candidates,
            versions      : process.out.versions
          ]).match() }
      )
    }
  }

  // GATE-04: when the sample maps to a single distinct subtype, the
  // length(selected_refs) > 1 guard must prevent any 2nd-rank *_cand2.fa from being written.
  //
  // D-05 note: with validity filtering removed from selection, "no minor" here
  // means "no SECOND distinct subtype to rank" (this fixture is 3a-only), not a
  // rule rejecting an otherwise-valid second candidate. Neutral ranking yields one
  // candidate; candidate_fasta carries only _cand1.fa and the candidates table has a single row.
  test("parsefirstmapping: no minor FASTA when no valid minor (GATE-04)") {
    options "--profile docker"
    when {
      process {
        """
        input[0] = [
          [ id: 'no_minor_test' ],
          file("${projectDir}/modules/local/parsefirstmapping/tests/no_minor.firstmapping.withdup.idxstats", checkIfExists: true),
          file("${projectDir}/modules/local/parsefirstmapping/tests/no_minor.tsv", checkIfExists: true)
        ]
        input[1] = file("${projectDir}/modules/local/parsefirstmapping/tests/references.fa", checkIfExists: true)
        input[2] = file("${projectDir}/bin/genotype_utils.R", checkIfExists: true)
        """
      }
    }
    then {
      // Single-subtype fixture => exactly one neutrally-ranked candidate (D-05).
      def candLines = path(process.out.candidates.get(0).get(1)).readLines()
      assertAll(
        { assert process.success },
        // Single-subtype fixture => exactly one candidate FASTA (_cand1.fa) and no
        // 2nd-rank FASTA emitted (no 2nd subtype to rank).
        { assert process.out.candidate_fasta.get(0).get(2).toString().contains("_cand1.fa") },
        { assert !process.out.candidate_fasta.get(0).get(2).toString().contains("_cand2.fa") },
        { assert candLines[0].contains('candidate_rank') },
        // header + exactly 1 candidate row
        { assert candLines.size() == 2 },
        { assert snapshot([
            csv           : process.out.csv,
            candidate_fasta: process.out.candidate_fasta,
            candidates    : process.out.candidates,
            versions      : process.out.versions
          ]).match() }
      )
    }
  }

  // GATE-02: an ERR1810469-class sample — a true 3a major whose coverage (9%)
  // fails minCov=29 even though its read count passes minRead=499 — must report
  // first-mapping stats (major_ref/major_reads/major_cov populated) but issue NO
  // minor call. The candidate 1a minor fields stay populated for QC (never blanked),
  // minor_call='no', and gate_flag='major_below_threshold'. These assertions read
  // the parsefirstmapping CSV directly so the gate decision is verified explicitly,
  // not only via the snapshot md5.
  test("parsefirstmapping: failing-major reports stats, no minor call (GATE-02)") {
    options "--profile docker"
    when {
      process {
        """
        input[0] = [
          [ id: 'ERR1810469_test' ],
          file("${projectDir}/modules/local/parsefirstmapping/tests/ERR1810469.firstmapping.withdup.idxstats", checkIfExists: true),
          file("${projectDir}/modules/local/parsefirstmapping/tests/ERR1810469.tsv", checkIfExists: true)
        ]
        input[1] = file("${projectDir}/modules/local/parsefirstmapping/tests/references.fa", checkIfExists: true)
        input[2] = file("${projectDir}/bin/genotype_utils.R", checkIfExists: true)
        """
      }
    }
    then {
      def csvLines = path(process.out.csv.get(0).get(1)).readLines()
      def header   = csvLines[0].split(',', -1) as List
      def row      = csvLines[1].split(',', -1) as List
      def cell     = { name -> row[header.indexOf(name)] }
      // Two distinct subtypes (3a + 1a) => neutral ranking selects BOTH as
      // candidates (D-05). The shim still gates: major fails minCov, so no minor
      // call — but candidate_rank 2 (1a) is present in the long-format table for QC.
      def candLines = path(process.out.candidates.get(0).get(1)).readLines()
      assertAll(
        { assert process.success },
        // Failing-major reason set; no minor call.
        { assert cell('gate_flag')  == 'major_below_threshold' },
        { assert cell('minor_call') == 'no' },
        // First-mapping stats reported for the (failing) major.
        { assert cell('major_ref')   == '3a_D17763' },
        { assert cell('major_reads') == '8079' },
        { assert cell('major_cov')   == '9' },
        // Candidate minor fields populated (never blanked) for QC.
        { assert cell('minor_ref')   == '1a_H77' },
        { assert cell('minor_reads') == '600' },
        { assert cell('minor_cov')   == '60' },
        // Long-format candidates table carries both ranks (header + 2 rows).
        { assert candLines[0].contains('candidate_rank') },
        { assert candLines.size() == 3 },
        { assert snapshot([
            csv           : process.out.csv,
            candidate_fasta: process.out.candidate_fasta,
            candidates    : process.out.candidates,
            versions      : process.out.versions
          ]).match() }
      )
    }
  }
}
