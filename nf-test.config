config {
    testsDir "."
    workDir System.getenv("NFT_WORKDIR") ?: ".nf-test"
    configFile "tests/nextflow.config"
    ignore 'modules/nf-core/**/*', 'subworkflows/nf-core/**/*'
    profile "test"
    triggers 'nextflow.config', 'nf-test.config', 'conf/test.config', 'tests/nextflow.config', 'tests/.nftignore'
    plugins {
        load "nft-utils@0.0.3"  // getAllFilesFromDir / removeNextflowVersion — the only plugin any test actually calls
        // Add plugins based on your pipeline needs:
        load "nft-bam@0.6.0"    // For BAM file testing
        load "nft-vcf@1.0.7"    // For VCF file testing
        // nft-fastq@0.0.1 REMOVED: its Groovy extension module is built against an
        // older Groovy than nf-test 0.9.5 ships, so merely loading it aborts every
        // test run with
        //   AbstractMethodError: Missing implementation of resolved method
        //   'abstract String getDisablePropertyName()' of AbstractExtensionMethodCache
        // (reproduced on JDK 17 and 21; nft-utils/nft-bam/nft-vcf are all clean).
        // No .nf.test in this repo calls a nft-fastq API, so it was pure template
        // cruft that silently broke the whole suite. Re-add only with a version
        // verified against the pinned nf-test.
    }
}
