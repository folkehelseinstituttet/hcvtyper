/*
 * Test config for the JOINT_MAPPING subworkflow nf-test.
 *
 * The production directives (ext.args2 region, ext.prefix slot names) live in
 * conf/modules_hcv.config and are wired by Plan 02. This test config supplies the
 * minimum needed to exercise the competitive-mapping flow in isolation:
 *   - BOWTIE2_ALIGN: keep the production --very-sensitive-local convention
 *   - SAMTOOLS_VIEW: emit BAM and pass the candidate reference name as the POSITIONAL
 *     region via ext.args2 (lands after ${input} in the module command — this is the
 *     reference-split mechanism, NOT the -r read-group flag, Pitfall 1). ext.prefix
 *     disambiguates the per-candidate output from the combined input BAM.
 */

// Cap resources so the test runs on small CI / dev machines. resourceLimits clamps the
// label-based requests (process_high asks for 12 CPUs) down to what the host provides.
process {
    resourceLimits = [ cpus: 2, memory: '4.GB', time: '1.h' ]
}

// Run docker containers as the invoking user so process outputs are NOT root-owned
// (otherwise nf-test cannot clean its own work dir between runs on a rootless host).
docker.runOptions = '-u $(id -u):$(id -g)'

process {

    withName: '.*JOINT_MAPPING:BOWTIE2_ALIGN' {
        ext.args = '--very-sensitive-local'
    }

    // SORMADUP runs on the COMBINED BAM (pre-split), so it carries only meta.id. A distinct
    // prefix is required so the dedup output BAM name does not collide with the staged input
    // BAM (both would default to ${meta.id}.bam -> markdup overwrites its own input). -r removes
    // duplicate reads (production ext.args5 convention).
    withName: '.*JOINT_MAPPING:SAMTOOLS_SORMADUP' {
        ext.prefix = { "${meta.id}.combined.nodup" }
        ext.args5  = '-r'
    }

    withName: '.*JOINT_MAPPING:SAMTOOLS_VIEW' {
        ext.args  = '--output-fmt bam'
        // Positional region = this candidate's reference name (carried in meta.candidate_ref).
        ext.args2 = { "${meta.candidate_ref}" }
        ext.prefix = { "${meta.id}.${meta.candidate_ref}.cand${meta.candidate_rank}.nodup" }
    }

    // Single-reference rebuild: distinct prefix so the output BAM name differs from the input.
    withName: '.*JOINT_MAPPING:REHEADER_CANDIDATE' {
        ext.prefix = { "${meta.id}.${meta.candidate_ref}.cand${meta.candidate_rank}.nodup.single" }
    }

    // Per-candidate DEPTH: -aa emits every position so breadth/ref-length are correct; the
    // prefix encodes candidate_ref so PLOTCOVERAGE's bam_coverage.R can match the filename
    // reference to the depth-file reference. DEPTH input is the joined-meta `meta1` namespace.
    withName: '.*JOINT_MAPPING:SAMTOOLS_DEPTH' {
        ext.args   = '-aa -d 1000000'
        ext.prefix = { "${meta1.id}.${meta1.candidate_ref}.cand${meta1.candidate_rank}.nodup" }
    }

    // Per-candidate consensus / distance prefixes (encode candidate slot for downstream parsing).
    withName: '.*JOINT_MAPPING:IVAR_CONSENSUS' {
        ext.prefix = { "${meta.id}.${meta.candidate_ref}.cand${meta.candidate_rank}" }
    }
    withName: '.*JOINT_MAPPING:CONSENSUS_DISTANCE' {
        ext.prefix = { "${meta.id}.${meta.candidate_ref}.cand${meta.candidate_rank}" }
    }
}
